{
  "name": "mlb-alert-telegram-agent",
  "version": "0.1.0",
  "description": "Telegram bot for concise MLB pre-game alerts with win probability.",
  "type": "module",
  "private": true,
  "scripts": {
    "prestart": "node scripts/prepare_start.js",
    "start": "node scripts/start_all.mjs",
    "bot": "node src/index.js",
    "predashboard": "node scripts/prepare_start.js",
    "dashboard": "node scripts/start_all.mjs",
    "dashboard:legacy": "node scripts/run_legacy_dashboard.mjs",
    "dashboard:api": "node scripts/run_api.mjs",
    "dashboard:web": "npm --prefix dashboard-react run dev -- --host 0.0.0.0 --port 5173",
    "dashboard:build": "npm --prefix dashboard-react run build",
    "setup:python": "node scripts/run_python.js scripts/setup_python.py",
    "setup:web": "npm --prefix dashboard-react install",
    "setup": "npm run setup:python && npm run setup:web",
    "migrate:storage": "node scripts/migrate_state_to_sqlite.js",
    "export:live": "node scripts/run_python.js scripts/export_sqlite_to_csv.py",
    "replay:calibration": "node scripts/run_python.js scripts/replay_calibration.py",
    "evaluate:artifacts": "node scripts/run_python.js scripts/build_evaluation_artifacts.py",
    "evaluate": "node scripts/run_python.js -m src.evaluate --sqlite data/state.sqlite --json reports/latest_metrics.json --report",
    "holdout:value-profile": "node scripts/run_python.js scripts/holdout_validate_rule.py",
    "model": "node scripts/run_python.js scripts/model_edge_validation.py && node scripts/run_python.js scripts/team_edge_analysis.py --write data/team_advantages.json",
    "model:validate": "npm run model",
    "replay": "node scripts/replay_prediction.js",
    "migrate-ledger": "node scripts/run_migrations.js --apply",
    "validate-ledger": "node scripts/validate_ledger.js",
    "generate-snapshot": "node scripts/generate_snapshot.js",
    "build-dashboard": "npm run dashboard:build",
    "validate": "npm run check && npm run test:js && npm run test:py && npm run dashboard:build",
    "quarantine:report": "node scripts/report_quarantine.js --json --out reports/quarantine_inventory.json",
    "doctor": "node scripts/doctor.mjs",
    "once": "node src/index.js --once",
    "test": "npm run check && npm run test:js && npm run test:py",
    "test:js": "node --test tests/*.js",
    "test:py": "node scripts/run_python.js -m pytest",
    "check": "node scripts/check_syntax.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fast-xml-parser": "^5.10.1"
  },
  "engines": {
    "node": ">=18.15"
  }
}
